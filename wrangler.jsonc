{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-software-toolkit-reference-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "account_id": "5486f4481dbb90280da7e6cb70258fb8",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ai-software-toolkit-reference-app",
    "database_id": "b9ffb4c6-2280-4c39-9bcc-a6f9a6f4168e",
    "migrations_dir": "migrations"
  }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "APP_REVISION": "development",
    "TOOLKIT_REVISION": "7b8b3a1edd6a4409faaee4d359a62e5820afb749"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
