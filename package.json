{
  "name": "ai-software-toolkit-reference-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fieldnotes: a deployed reference consumer of AI Software Toolkit",
  "license": "MIT",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "wrangler dev --port 8791 --inspector-port 0",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir dist",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "c8 --include='src/**/*.ts' --exclude='src/index.ts' --reporter=text --reporter=lcov --reporter=cobertura --check-coverage --lines=90 --branches=85 npm test",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "eslint src public --max-warnings 0 && node --check public/app.js",
    "validate:migrations": "python3 scripts/validate_migrations.py",
    "toolkit:check": "scripts/toolkit-check.sh",
    "polyglot:setup": "python3 scripts/polyglot.py setup",
    "polyglot:check": "python3 scripts/polyglot.py check",
    "polyglot:lint": "python3 scripts/polyglot.py check --stage lint",
    "polyglot:test": "python3 scripts/polyglot.py check --stage test",
    "polyglot:build": "python3 scripts/polyglot.py check --stage build",
    "polyglot:architecture": "python3 scripts/polyglot.py check --stage architecture",
    "polyglot:format": "prettier --check examples/polyglot/typescript/src examples/polyglot/typescript/dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "c8": "12.0.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "miniflare@5.20261019.0-beta": {
      "undici": "7.30.1"
    },
    "ajv@6.15.0": {
      "uri-js": "npm:fast-uri@4.2.2"
    }
  }
}
